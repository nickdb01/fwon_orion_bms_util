#!/bin/bash
set -euo pipefail
ORION_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Keep build caches inside the project; do not alter the system's xcode-select.
if [[ -z "${DEVELOPER_DIR:-}" && -d /Applications/Xcode.app/Contents/Developer ]]; then
    export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi
export CLANG_MODULE_CACHE_PATH="$ORION_ROOT/.build/clang-cache"
export SWIFTPM_MODULECACHE_OVERRIDE="$ORION_ROOT/.build/module-cache"
cd "$ORION_ROOT"
exec xcrun swift "$@" --build-system native --disable-sandbox --cache-path "$ORION_ROOT/.build/cache" --config-path "$ORION_ROOT/.build/config" --security-path "$ORION_ROOT/.build/security"
